<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.yaroni.claude-ingest</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>/Users/yaroni/projects/claude-skills-guide/scripts/publish.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/yaroni/projects/claude-skills-guide</string>

  <!-- launchd ולא cron: cron לא משלים ריצה שהוחמצה כשהמק ישן -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>2</integer>
    <key>Minute</key><integer>0</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/yaroni/projects/claude-skills-guide/.launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/yaroni/projects/claude-skills-guide/.launchd.err.log</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
